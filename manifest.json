{
  "manifest_version": 3,
  "name": "JD 商品采集助手",
  "version": "0.1.0",
  "description": "识别当前京东页面与登录状态，一键采集商品详情和评论，仅用于个人学习与数据分析。",

  "permissions": [
    "cookies",
    "storage",
    "tabs",
    "alarms",
    "activeTab",
    "scripting"
  ],

  "host_permissions": [
    "https://*.jd.com/*"
  ],

  "background": {
    "service_worker": "background.js",
    "type": "module"
  },

  "action": {
    "default_title": "JD 商品采集助手",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "content_scripts": [
    {
      "matches": ["https://*.jd.com/*"],
      "js": [
        "lib/selectors.js",
        "lib/utils.js",
        "lib/crawler.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
